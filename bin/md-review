#!/bin/sh
# Open a Markdown file in herdr's md-review panel for review.
# Waits until "Done" is clicked in the panel, then prints the reviewer's
# changes as a diff (empty: no changes). --no-wait: open and return.
# --rule: print the agent rule, only inside herdr (for a SessionStart hook).
# herdr terminals set HC_TERMINAL_ID; outside herdr there is no panel to open.
if [ "$1" = --rule ]; then
  [ -n "$HC_TERMINAL_ID" ] && cat "$(dirname "$(readlink -f "$0")")/../rule.md"
  exit 0
fi
[ -n "$HC_TERMINAL_ID" ] || { echo "md-review: not running inside herdr; ask for the review in chat instead" >&2; exit 2; }
wait=1; [ "$1" = --no-wait ] && { wait=; shift; }
[ -f "$1" ] || { echo "usage: md-review [--no-wait] <file.md>" >&2; exit 1; }
home=${HERDR_APP_HOME:-$HOME/.config/herdr-app}
p=$(realpath "$1")
done_dir=$home/data/review-done
mkdir -p "$home/data/md-review-open" "$done_dir"
# A Done clicked while nobody waited for this file must not end this review.
for f in "$done_dir"/*.path; do [ -f "$f" ] && [ "$(cat "$f")" = "$p" ] && rm -f "$f"; done
snap=$(mktemp); cp "$p" "$snap"
printf '%s' "$p" > "$home/data/md-review-open/$(date +%s)-$$.path"
case "$(herdr-app status 2>/dev/null)" in
  *'"md-review"'*) ;;
  *) herdr-app do mod.open '{"name":"md-review"}' >/dev/null ;;
esac
[ -n "$wait" ] || { rm -f "$snap"; exit 0; }
# ponytail: 1 s poll; inotifywait if latency ever matters
while :; do
  for f in "$done_dir"/*.path; do
    [ -f "$f" ] && [ "$(cat "$f")" = "$p" ] && { rm -f "$f"; break 2; }
  done
  sleep 1
done
echo "Review done: $p"
diff -u --label before --label after "$snap" "$p" || true
rm -f "$snap"
